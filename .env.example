# Copy to .env.local and fill in. Nothing here is committed.

# --- Site -------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://www.example.com

# --- Verified company details (leave empty until confirmed) -----------
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_EMAIL=
# International format, digits only, e.g. 94771234567
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Google Maps "Share > Embed a map" src URL
NEXT_PUBLIC_MAP_EMBED_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_YOUTUBE_URL=
# e.g. /aquazone-company-profile.pdf (place the PDF in /public)
NEXT_PUBLIC_PROFILE_PDF=

# --- Inquiry delivery (configure at least one for production) ---------
# Email via Resend (https://resend.com)
RESEND_API_KEY=
INQUIRY_TO_EMAIL=export@example.com
INQUIRY_FROM_EMAIL=Aquazone Website <inquiries@your-verified-domain.com>
# Or / and: CRM / Zapier / Make / HubSpot-forms webhook that accepts JSON
CRM_WEBHOOK_URL=

# --- Optional spam protection (Cloudflare Turnstile) ------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
